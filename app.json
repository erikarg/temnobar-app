{
  "expo": {
    "name": "TemNoBar",
    "slug": "temnobar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.temnobar.mobile"
    },
    "android": {
      "package": "com.temnobar.mobile"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "9dd20690-7b64-4df7-b802-181355123cff"
      }
    },
    "owner": "erikargs-organization"
  }
}
